{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "clone_rep": "ssh u3631000@server55.hosting.reg.ru \"git clone https://github.com/asmi046/ekvipo www/ekvipo.com\"",
        "composer_remove": "ssh u3631000@server55.hosting.reg.ru \"cd www/ekvipo.com && /opt/php/8.5/bin/php composer.phar dumpauto\"",
        "composer_install": "ssh u3631000@server55.hosting.reg.ru \"cd www/ekvipo.com && /opt/php/8.5/bin/php composer.phar install\"",
        "composer_update": "ssh u3631000@server55.hosting.reg.ru \"cd www/ekvipo.com && /opt/php/8.5/bin/php composer.phar update\"",
        "pull_rep": "ssh u3631000@server55.hosting.reg.ru \"cd www/ekvipo.com && git pull\"",
        "clean_rep": "ssh u3631000@server55.hosting.reg.ru \"cd www/ekvipo.com && git clean -f\"",
        "stash": "ssh u3631000@server55.hosting.reg.ru \"cd www/ekvipo.com && git stash\"",
        "reset_rep": "ssh u3631000@server55.hosting.reg.ru \"cd www/ekvipo.com && git reset --hard\"",
        "send_vite_build": "scp -C -r public/build u3631000@server55.hosting.reg.ru:www/ekvipo.com/public",
        "migrate_rep": "ssh u3631000@server55.hosting.reg.ru \"cd www/ekvipo.com && /opt/php/8.5/bin/php artisan migrate\"",
        "rollback_rep": "ssh u3631000@server55.hosting.reg.ru \"cd www/ekvipo.com && /opt/php/8.5/bin/php artisan migrate:rollback\"",
        "seed_rep": "ssh u3631000@server55.hosting.reg.ru \"cd www/ekvipo.com && /opt/php/8.5/bin/php artisan DB:seed\"",
        "seed_rep_one": "ssh u3631000@server55.hosting.reg.ru \"cd www/ekvipo.com && /opt/php/8.5/bin/php artisan DB:seed ProductTagSeeder\"",
        "optimized_rep": "ssh u3631000@server55.hosting.reg.ru \"cd www/ekvipo.com && /opt/php/8.5/bin/php composer.phar update --optimize-autoloader --no-dev\"",
        "dump_autoload": "ssh u3631000@server55.hosting.reg.ru \"cd www/ekvipo.com && /opt/php/8.5/bin/php composer.phar dump-autoload\"",
        "storage_link": "ssh u3631000@server55.hosting.reg.ru \"cd www/ekvipo.com && /opt/php/8.5/bin/php artisan storage:link\"",
        "key_gen": "ssh u3631000@server55.hosting.reg.ru \"cd www/ekvipo.com && /opt/php/8.5/bin/php artisan key:generate\"",
        "cache_config": "ssh u3631000@server55.hosting.reg.ru \"cd www/ekvipo.com && /opt/php/8.5/bin/php artisan config:cache\"",
        "cache_route": "ssh u3631000@server55.hosting.reg.ru \"cd www/ekvipo.com && /opt/php/8.5/bin/php artisan route:cache\"",
        "cache_view": "ssh u3631000@server55.hosting.reg.ru \"cd www/ekvipo.com && /opt/php/8.5/bin/php artisan view:cache\"",
        "cache_clear": "ssh u3631000@server55.hosting.reg.ru \"cd www/ekvipo.com && /opt/php/8.5/bin/php artisan cache:clear\"",
        "optimize": "ssh u3631000@server55.hosting.reg.ru \"cd www/ekvipo.com && /opt/php/8.5/bin/php artisan optimize\"",
        "optimize_all": "npm run optimize && npm run cache_clear && npm run cache_view && npm run cache_route && npm run cache_config",
        "deploy_m": "vite build && npm run send_vite_build && npm run pull_rep && npm run optimize_all"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
